// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+j",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen"
    } ,
    {
        "key": "ctrl+w h",
        "command": "imePaneSwitch.navigate",
        "args": { "command": "workbench.action.navigateLeft", "im": "1033" },
        "when": "!editorTextFocus"

    },
    {
        "key": "ctrl+w j",
        "command": "imePaneSwitch.navigate",
        "args": { "command": "workbench.action.navigateDown", "im": "1033" },
        "when": "!editorTextFocus"

    },
    {
        "key": "ctrl+w k",
        "command": "imePaneSwitch.navigate",
        "args": { "command": "workbench.action.navigateUp", "im": "1033" },
        "when": "!editorTextFocus"

    },
    {
        "key": "ctrl+w l",
        "command": "imePaneSwitch.navigate",
        "args": { "command": "workbench.action.navigateRight", "im": "1033" },
        "when": "!editorTextFocus"
    },
]